# Copy to .env.local and fill in. All NEXT_PUBLIC_* values are exposed to the browser.

# Canonical production URL (used for metadata, sitemap, schema, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.kinetictherapyclinic.ca

# Jane online booking URL (already set in content/site-content.json; env overrides if present)
NEXT_PUBLIC_JANE_BOOKING_URL=https://kineticphysiotherapy.janeapp.com/

# Contact form: Web3Forms access key (free at https://web3forms.com), used by
# the server-side relay at app/api/contact/route.node.ts. Preferred over the
# NEXT_PUBLIC_ variant below since it's never sent to the browser.
# If neither this nor NEXT_PUBLIC_WEB3FORMS_KEY is set, the relay returns 501
# and the contact/intake forms fall back to a mailto: link automatically.
# NOTE: this one has no effect on a static SiteGround build — there's no server
# to keep it secret. Static builds must use NEXT_PUBLIC_WEB3FORMS_KEY below.
WEB3FORMS_KEY=

# Client-readable Web3Forms key.
# - Node/Vercel deploys: only a legacy fallback — prefer WEB3FORMS_KEY above.
# - Static SiteGround deploys (npm run build:static): REQUIRED for the forms to
#   deliver, because the browser posts to Web3Forms itself. Without it the
#   forms fall back to opening the visitor's email app. A Web3Forms access key
#   is a submission-only token — it can't read past submissions — so exposing
#   it is how the service is designed to be used on static sites. Worst case
#   someone submits spam to your form; rotate the key if that happens.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# The clinic's Google review link, used by the /review page's "Leave a Google
# review" button (app/review/ReviewOptions.tsx). Find it in Google Business
# Profile → Ask for reviews. Until this is set the button points at a
# placeholder and the review flywheel doesn't work — set it before launch.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Set to 1 to show draft blog posts in a production build, e.g. on a preview deployment.
NEXT_PUBLIC_SHOW_DRAFTS=

# AI booking concierge (server-side only — never NEXT_PUBLIC). Get a key at https://console.anthropic.com
# Has no effect on a static build: there is no server to run the concierge on.
ANTHROPIC_API_KEY=
# Optional model override for the concierge (default claude-opus-4-8; set claude-haiku-4-5 for lower cost)
CONCIERGE_MODEL=

# ---------------------------------------------------------------------------
# Static / SiteGround deploys only — see docs/DEPLOY_SITEGROUND.md
# ---------------------------------------------------------------------------

# Set automatically by `npm run build:static`; you don't normally set it here.
# When "1", the build emits a plain folder of files in out/ instead of a Next
# server, and the app/api/** route handlers are excluded from the build.
NEXT_PUBLIC_STATIC_EXPORT=

# Optional. Absolute origin that hosts this app's API routes, if you run them
# somewhere separate (e.g. a small free Vercel project). Set it and a static
# SiteGround build regains the AI concierge, the AI intake summary, and the
# server-side contact relay. Leave blank and those degrade gracefully.
# The origin must allow this site's domain — see lib/rate-limit.ts.
NEXT_PUBLIC_API_BASE_URL=
