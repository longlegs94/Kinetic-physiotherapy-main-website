# Copy to .env.local and fill in. All NEXT_PUBLIC_* values are exposed to the browser.

# Canonical production URL (used for metadata, sitemap, schema, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.kinetictherapyclinic.ca

# Jane online booking URL (already set in content/site-content.json; env overrides if present)
NEXT_PUBLIC_JANE_BOOKING_URL=https://kineticphysiotherapy.janeapp.com/

# Contact form: Web3Forms access key (free at https://web3forms.com), used by
# the server-side relay at app/api/contact/route.ts. Preferred over the
# NEXT_PUBLIC_ variant below since it's never sent to the browser.
# If neither this nor NEXT_PUBLIC_WEB3FORMS_KEY is set, the relay returns 501
# and the contact/intake forms fall back to a mailto: link automatically.
WEB3FORMS_KEY=

# Legacy client-side Web3Forms key. Kept only as a fallback for deployments
# that already set this — the browser can read it, so prefer WEB3FORMS_KEY
# above for new setups. Not used directly by the forms anymore (they post to
# /api/contact instead).
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# Set to 1 to show draft blog posts in a production build, e.g. on a preview deployment.
NEXT_PUBLIC_SHOW_DRAFTS=

# AI booking concierge and pre-visit intake summarizer (server-side only —
# never NEXT_PUBLIC). Powers the "Not sure what to book?" chat widget, the
# "Describe it in your own words" box, and the AI summary on the intake form.
# Without it, all three degrade to a phone number and a contact link — the
# rest of the site is unaffected. Get a key at https://platform.openai.com
OPENAI_API_KEY=
# Master on/off switch for every AI surface: the "Describe it in your own
# words" box, the floating chat bubble, the "Ask our assistant" button under
# the FAQs, and the AI summary on the pre-visit intake form.
# Leave blank (or set 1/true/on) to keep it running. Set to 0/false/off to
# switch it off — the surfaces disappear cleanly rather than showing a dead
# input, and the non-AI paths (pain-point buttons, FAQ accordion, phone
# number) carry on unchanged. The API also refuses requests while it is off,
# so no spend is possible. Takes effect on the next deploy.
NEXT_PUBLIC_AI_ASSISTANT_ENABLED=

# Optional model override, shared by the concierge and the intake summarizer
# (default gpt-5.4-mini). gpt-5.4-nano is cheaper still, but is a smaller
# model and more likely to drift off the guardrails in the system prompt —
# the deterministic emergency scan in lib/red-flags.ts backstops either
# choice, but nano is a real cost/reliability tradeoff, not a free downgrade.
CONCIERGE_MODEL=

# Signs the concierge's own replies so the browser can replay them without
# being able to forge them (lib/message-auth.ts). Must be at least 32 chars —
# generate with: openssl rand -base64 48
# If unset, the concierge still works but forgets prior assistant turns,
# because unsigned assistant messages are dropped rather than trusted.
CONCIERGE_SIGNING_SECRET=

# The clinic's Google review link, e.g.
# https://search.google.com/local/writereview?placeid=<PLACE_ID> or a
# https://g.page/r/<id>/review short link. Find it in the Google Business
# Profile dashboard ("Ask for reviews").
# If unset, the /review page hides the Google card entirely rather than
# rendering a dead button. If set to something unusable, the production build
# fails — see scripts/check-env.ts.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Shared, atomic rate limiting across serverless instances (lib/rate-limit.ts).
# Without these the limiter falls back to per-instance memory, which is a soft
# throttle only: the effective limit becomes (limit x warm instances).
# Create a free database at https://upstash.com and copy the REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to 1 to render content still flagged needsVerification in
# content/site-content.json. Intended for preview deploys, where the clinic
# reviews drafts before approving them. Production leaves this unset so
# unconfirmed testimonials and practitioner credentials stay hidden.
NEXT_PUBLIC_SHOW_UNVERIFIED=

# Set to 1 to make the build fail while any needsVerification content remains,
# rather than only warning. Turn this on once the clinic has signed off.
REQUIRE_VERIFIED_CONTENT=
